{
  "discard_if": [
    {"when": "priority_tag", "remove": ["conflicting_a", "conflicting_b"]}
  ],
  "drop_on_pair": [
    {
      "if_all": ["tag_x", "tag_y"],
      "drop": "tag_x",
      "flag": "tag_x_tag_y",
      "add_if_trigger_in": {"add": "tag_z", "any_of": ["trigger_a"]}
    }
  ],
  "drop_on_pair_unless": [
    {"if_all": ["tag_m", "tag_n"], "unless": "tag_o", "drop": "tag_m", "flag": "tag_m_tag_n"}
  ],
  "require_any_when": [
    {"when": "summary_tag", "any_of": ["detail_a", "detail_b"], "flag": "summary_missing_detail"}
  ]
}
