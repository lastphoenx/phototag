# Kopie nach .env oder export vor dem Aufruf (Werte nie committen).
PHOTOTAG_DB=phototag.db
PHOTOTAG_API=http://127.0.0.1:11434/v1
PHOTOTAG_MODEL=qwen2.5vl:7b
PHOTOTAG_CATEGORIES=/opt/phototag/categories.txt
PHOTOTAG_VIDEO_FRAMES=6
# PHOTOTAG_MAX_TAGS=12
# Caption: gespeichert + Modell-Prompt (Default 320, früher fest 160)
# PHOTOTAG_CAPTION_MAX=320

# Pin fuer update-from-github.sh: **nicht** in phototag.env — nur einmal in der Shell:
#   PHOTOTAG_UPDATE_REF=v0.3.7 ./scripts/update-from-github.sh

# Ollama /v1: Qwen3 — Denken abschalten (leer = Feld nicht senden)
PHOTOTAG_REASONING_EFFORT=none
PHOTOTAG_MAX_TOKENS=2048
# PHOTOTAG_PROMPT_LANG=de
# PHOTOTAG_VERBOSE=1
# PHOTOTAG_TAG_SANITIZE=1
# PHOTOTAG_SANITIZE_RULES=/pfad/nur-auf-server/sanitize-rules.json
# PHOTOTAG_REQUIRED_TAGS_FILE=/pfad/nur-auf-server/required-tags.txt

# Nacht-Lauf scripts/night-tag-loop.sh — siehe DEPLOY.md Abschnitt „Nacht-Lauf“
# PHOTOTAG_SCAN_ROOT=/mnt/dein-mount
# rclone: Remote mit Doppelpunkt (nur phototag.env, Homelab-Name eintragen)
# PHOTOTAG_RCLONE_MOUNT=your_remote:
# PHOTOTAG_NIGHT_BATCH=20
# PHOTOTAG_NIGHT_SLEEP=45
# PHOTOTAG_NIGHT_END_HOUR=7
# PHOTOTAG_NIGHT_IMAGES_FIRST=1
# PHOTOTAG_NIGHT_KIND=image
# PHOTOTAG_NIGHT_RESCAN_WHEN_IDLE=0

# Nextcloud Schlagworte (push-nc) — **entweder** Token-Datei **oder** PHOTOTAG_NC_APP_PASSWORD=
# PHOTOTAG_NC_URL=https://nextcloud.example.com
# PHOTOTAG_NC_USER=dein_nc_user
# PHOTOTAG_NC_TOKEN_FILE=/opt/phototag/secrets/nc-app-token.txt
# PHOTOTAG_NC_APP_PASSWORD=
# Pfad unter .../dav/files/USER/ der zum scan-root passt
# PHOTOTAG_NC_DAV_PREFIX=Photos
# HTTPS mit eigener CA: PHOTOTAG_NC_CA_FILE=/pfad/zur/ca.pem
# Nur zum Testen ohne Zertifikatsprüfung: PHOTOTAG_NC_TLS_INSECURE=1
# Schlagwort-Sichtbarkeit in NC: public | restricted | invisible
# PHOTOTAG_NC_TAG_LEVEL=public

# Review-Admin (phototag serve) — nur in phototag.env auf dem CT, chmod 600, nie committen
#
# | Variable | Pflicht? | Wofür |
# | PHOTOTAG_ADMIN_USER | ja (serve) | Browser-Login Benutzername |
# | PHOTOTAG_ADMIN_PASSWORD | ja* | Browser-Login Passwort (Klartext, wie NC-App-Passwort) |
# | PHOTOTAG_ADMIN_PASSWORD_HASH | ja* | Statt Klartext: werkzeug-Hash (siehe DEPLOY.md) |
# | PHOTOTAG_ADMIN_BIND | nein | 0.0.0.0 = LAN; 127.0.0.1 = nur auf dem CT |
# | PHOTOTAG_ADMIN_PORT | nein | Standard 8765 |
# | PHOTOTAG_ADMIN_SESSION_SECRET | nein | Cookie-Signatur (empfohlen wenn kein TOKEN) |
# | PHOTOTAG_ADMIN_TOKEN | nein | Nur API/curl (Header X-Phototag-Token), nicht Browser |
#
# PHOTOTAG_ADMIN_USER=dein_name
# PHOTOTAG_ADMIN_PASSWORD=...
# PHOTOTAG_ADMIN_BIND=0.0.0.0
# PHOTOTAG_ADMIN_PORT=8765
# PHOTOTAG_ADMIN_SESSION_SECRET=optional-langer-zufall
# PHOTOTAG_ADMIN_PASSWORD_HASH=scrypt:...   # optional statt PASSWORD
# Optional API: PHOTOTAG_ADMIN_TOKEN=...
# 2FA: vor phototag nginx/Authelia im Homelab (privates doku), nicht im Repo
