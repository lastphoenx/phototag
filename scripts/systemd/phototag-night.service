[Unit]
Description=phototag night scan+tag loop until morning
After=network-online.target phototag-rclone-mount.service
Wants=network-online.target phototag-rclone-mount.service

[Service]
Type=oneshot
TimeoutStartSec=7h
Environment=PHOTOTAG_INSTALL_DIR=/opt/phototag
Environment=PHOTOTAG_ENV=/opt/phototag/phototag.env
# PHOTOTAG_SCAN_ROOT und Nacht-Optionen in phototag.env (nicht erfundener Beispielpfad).
EnvironmentFile=-/opt/phototag/phototag.env
# Optional hier überschreiben (sonst Defaults im Skript: batch 20, sleep 45):
# Environment=PHOTOTAG_NIGHT_BATCH=15
# Environment=PHOTOTAG_NIGHT_SLEEP=60
ExecStart=/opt/phototag/scripts/night-tag-loop.sh
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
